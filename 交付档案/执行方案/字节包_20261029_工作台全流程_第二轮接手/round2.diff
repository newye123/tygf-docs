diff --git a/src/lib/workbench/workbench-mode-preference.ts b/src/lib/workbench/workbench-mode-preference.ts
index e69de29..b83900b 100644
--- /dev/null
+++ b/src/lib/workbench/workbench-mode-preference.ts
@@ -0,0 +1,38 @@
+const STORAGE_KEY = 'tygf-workbench-mode-preference-v1'
+
+type SessionStorageLike = Pick<Storage, 'getItem' | 'setItem'>
+
+function getSessionStorage(): SessionStorageLike | null {
+  try {
+    return typeof window === 'undefined' ? null : window.sessionStorage
+  } catch {
+    return null
+  }
+}
+
+/** 标签页内只记单稿/多稿偏好，不保存设计稿、扫描、授权或执行状态。 */
+export function readWorkbenchModePreference(
+  storage: SessionStorageLike | null = getSessionStorage(),
+): boolean | null {
+  if (!storage) return null
+  try {
+    const value = storage.getItem(STORAGE_KEY)
+    return value === 'true' ? true : value === 'false' ? false : null
+  } catch {
+    return null
+  }
+}
+
+/** 存储不可用时不影响模式切换。 */
+export function writeWorkbenchModePreference(
+  isMultiDraft: boolean,
+  storage: SessionStorageLike | null = getSessionStorage(),
+): boolean {
+  if (!storage) return false
+  try {
+    storage.setItem(STORAGE_KEY, String(isMultiDraft))
+    return true
+  } catch {
+    return false
+  }
+}
diff --git a/tests/unit/workbench-mode-preference.test.ts b/tests/unit/workbench-mode-preference.test.ts
index e69de29..9312478 100644
--- /dev/null
+++ b/tests/unit/workbench-mode-preference.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import {
+  readWorkbenchModePreference,
+  writeWorkbenchModePreference,
+} from '@/lib/workbench/workbench-mode-preference'
+
+const KEY = 'tygf-workbench-mode-preference-v1'
+
+describe('workbench mode preference', () => {
+  it('stores only the single/multi boolean in session storage', () => {
+    const values = new Map<string, string>()
+    const storage = {
+      getItem: (key: string) => values.get(key) ?? null,
+      setItem: (key: string, value: string) => values.set(key, value),
+    }
+
+    expect(writeWorkbenchModePreference(true, storage)).toBe(true)
+    expect(values.size).toBe(1)
+    expect([...values.entries()]).toEqual([[KEY, 'true']])
+    expect(readWorkbenchModePreference(storage)).toBe(true)
+
+    expect(writeWorkbenchModePreference(false, storage)).toBe(true)
+    expect(values.size).toBe(1)
+    expect([...values.entries()]).toEqual([[KEY, 'false']])
+    expect(readWorkbenchModePreference(storage)).toBe(false)
+  })
+
+  it('ignores missing or invalid preference values', () => {
+    const storage = { getItem: () => 'path-or-permission-state', setItem: vi.fn() }
+    expect(readWorkbenchModePreference(storage)).toBe(null)
+    expect(readWorkbenchModePreference(null)).toBe(null)
+    expect(writeWorkbenchModePreference(true, null)).toBe(false)
+  })
+
+  it('keeps the workbench usable when browser storage throws', () => {
+    const storage = {
+      getItem: () => { throw new Error('blocked') },
+      setItem: () => { throw new Error('blocked') },
+    }
+    expect(readWorkbenchModePreference(storage)).toBe(null)
+    expect(writeWorkbenchModePreference(true, storage)).toBe(false)
+  })
+})
